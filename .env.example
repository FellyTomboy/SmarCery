# Salin file ini menjadi .env, lalu isi API key lokal Anda.
AI_GATEWAY_API_KEY=your_olagon_api_key
AI_GATEWAY_BASE_URL=https://gateway.olagon.site/anthropic
AI_GATEWAY_MODEL=claude-opus-4-7

# Konfigurasi database lokal (opsional jika memakai default aplikasi).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smarcery
DB_USER=root
DB_PASS=root
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=smarcery
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
