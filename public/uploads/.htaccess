# Disable directory listing and script execution for uploads
Options -Indexes -ExecCGI
AddDefaultCharset UTF-8

# Only allow direct access to image files via HTTP
<FilesMatch "\.(php|phtml|phar|pl|py|cgi|sh|bat)$">
    Require all denied
</FilesMatch>

# Block PHP in any subdir
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
